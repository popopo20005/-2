import { useState, useEffect } from 'react';
import { GlassCard } from './ui/GlassCard';
import { NeumorphicButton } from './ui/NeumorphicButton';
import { DashboardHeader } from './dashboard/DashboardHeader';
import { RingChart } from './dashboard/RingChart';
import { SkeletonStatGrid, Skeleton } from './ui/Skeleton';
import {
  BookOpen,
  BarChart3,
  Plus,
  Clock,
  Target,
  Sparkles,
  HelpCircle,
  Flame,
  Zap
} from 'lucide-react';
import type { View } from '../types';
import { historyService, spacedRepetitionService, quizSetService, problemService } from '../lib/database';
import { getTodayStudyTime } from '../lib/studyTimeService';
import type { QuizSet } from '../types';
import { UserNameSettings } from './UserNameSettings';
import { motion } from 'framer-motion';

interface DashboardProps {
  onNavigate: (view: View) => void;
  language?: 'ja' | 'en';
  onToggleDarkMode?: () => void;
  isDarkMode?: boolean;
}

export function Dashboard({ onNavigate, language = 'ja', onToggleDarkMode, isDarkMode = false }: DashboardProps) {
  const [userName, setUserName] = useState('');
  const [streakDays, setStreakDays] = useState(0);
  const [todayQuestions, setTodayQuestions] = useState(0);
  const [todayAccuracy, setTodayAccuracy] = useState(0);
  const [learningTime, setLearningTime] = useState(0); // Minutes
  const [learningTimeSeconds, setLearningTimeSeconds] = useState(0); // Seconds
  const [reviewNeeded, setReviewNeeded] = useState(0);
  const [isLoading, setIsLoading] = useState(true);
  const [showNameSettings, setShowNameSettings] = useState(false);
  const [recommendedQuizSet, setRecommendedQuizSet] = useState<QuizSet | null>(null);

  // Level System Mock Data (To be replaced with real data)
  const [level, setLevel] = useState(12);

  useEffect(() => {
    loadDashboardData();
  }, []);

  const loadDashboardData = async () => {
    try {
      const savedUserName = localStorage.getItem('userName') || (language === 'ja' ? 'ユーザー' : 'User');
      setUserName(savedUserName);

      const streak = await calculateStreak();
      setStreakDays(streak);

      const today = new Date();
      today.setHours(0, 0, 0, 0);

      const allHistory = await historyService.getAll();
      const todayHistory = allHistory.filter(h => {
        const historyDate = new Date(h.timestamp);
        historyDate.setHours(0, 0, 0, 0);
        return historyDate.getTime() === today.getTime();
      });

      setTodayQuestions(todayHistory.length);

      if (todayHistory.length > 0) {
        const correct = todayHistory.filter(h => h.isCorrect).length;
        setTodayAccuracy(Math.round((correct / todayHistory.length) * 100));
      }

      const todayStudySeconds = await getTodayStudyTime();
      const todayStudyMinutes = Math.floor(todayStudySeconds / 60);
      setLearningTime(todayStudyMinutes);
      setLearningTimeSeconds(todayStudySeconds);

      const allCards = await spacedRepetitionService.getAllCards();
      const now = new Date();
      const dueCards = allCards.filter(card =>
        card.nextReviewDate <= now && !card.isNew
      );
      setReviewNeeded(dueCards.length);

      await loadPersonalizedRecommendation(allHistory);

      // Mock Level Calculation based on total history
      const totalSolved = allHistory.length;
      const calculatedLevel = Math.floor(totalSolved / 50) + 1;
      setLevel(calculatedLevel);

      setIsLoading(false);
    } catch (error) {
      console.error('Failed to load dashboard data:', error);
      setIsLoading(false);
    }
  };

  const calculateStreak = async (): Promise<number> => {
    try {
      const allHistory = await historyService.getAll();
      if (allHistory.length === 0) return 0;

      const sortedHistory = allHistory.sort((a, b) =>
        new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()
      );

      let streak = 0;
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      let checkDate = new Date(today);

      for (let i = 0; i < 30; i++) {
        const dayHistory = sortedHistory.some(h => {
          const historyDate = new Date(h.timestamp);
          historyDate.setHours(0, 0, 0, 0);
          return historyDate.getTime() === checkDate.getTime();
        });

        if (dayHistory) {
          streak++;
          checkDate.setDate(checkDate.getDate() - 1);
        } else {
          break;
        }
      }

      return streak;
    } catch (error) {
      console.error('Failed to calculate streak:', error);
      return 0;
    }
  };

  const loadPersonalizedRecommendation = async (allHistory: any[]) => {
    try {
      const categoryStats: Record<string, { correct: number; total: number }> = {};

      allHistory.forEach(h => {
        if (!categoryStats[h.category]) {
          categoryStats[h.category] = { correct: 0, total: 0 };
        }
        categoryStats[h.category].total++;
        if (h.isCorrect) {
          categoryStats[h.category].correct++;
        }
      });

      let worstCategory = '';
      let lowestAccuracy = 100;

      Object.entries(categoryStats).forEach(([category, stats]) => {
        if (stats.total >= 5) {
          const accuracy = (stats.correct / stats.total) * 100;
          if (accuracy < lowestAccuracy) {
            lowestAccuracy = accuracy;
            worstCategory = category;
          }
        }
      });

      const allQuizSets = await quizSetService.getAll();

      if (worstCategory && allQuizSets.length > 0) {
        const allProblems = await problemService.getAll();
        const categoryProblems = allProblems.filter(p => p.category === worstCategory);
        const categoryProblemIds = categoryProblems.map(p => p.id!);

        let bestQuizSet: QuizSet | null = null;
        let maxMatchCount = 0;

        for (const quizSet of allQuizSets) {
          const matchCount = quizSet.problemIds.filter(id =>
            categoryProblemIds.includes(id)
          ).length;

          if (matchCount > maxMatchCount) {
            maxMatchCount = matchCount;
            bestQuizSet = quizSet;
          }
        }

        setRecommendedQuizSet(bestQuizSet);
      } else if (allQuizSets.length > 0) {
        const sortedSets = allQuizSets.sort((a, b) =>
          new Date(b.createdAt || 0).getTime() - new Date(a.createdAt || 0).getTime()
        );
        setRecommendedQuizSet(sortedSets[0]);
      }
    } catch (error) {
      console.error('Failed to load personalized recommendation:', error);
    }
  };

  const handleSaveUserName = (name: string) => {
    localStorage.setItem('userName', name);
    setUserName(name);
  };

  const todayGoal = 20;

  const t = {
    ja: {
      greeting: `👋 おかえりなさい、${userName}さん`,
      subtitle: '今日の学習目標を達成しましょう',
      todayProgress: '今日の進捗',
      solvedProblems: '解いた問題',
      accuracy: '正答率',
      learningTime: '学習時間',
      recommendedActions: 'ネクストアクション',
      reviewNeeded: '復習が必要です',
      reviewDescription: '忘却曲線に基づき、最適なタイミングで復習しましょう',
      noReviewNeeded: 'すべて完了！',
      noReviewDescription: '素晴らしい！復習タスクはすべて完了しました。',
      startReview: '復習を開始',
      viewCards: 'カードを確認',
      newProblems: '新しい問題セット',
      newDescription: 'あなたのレベルに合わせた問題セット',
      personalizedRecommendation: 'おすすめの学習',
      startLearning: '学習を開始',
      quickAccess: 'クイックアクセス',
      quizSets: '問題集',
      statistics: '統計',
      create: '作成',
      guide: 'ガイド',
      rankName: 'マスターラーナー',
    },
    en: {
      greeting: `👋 Welcome back, ${userName}`,
      subtitle: "Let's achieve your daily goals",
      todayProgress: "Today's Progress",
      solvedProblems: 'Solved',
      accuracy: 'Accuracy',
      learningTime: 'Study Time',
      recommendedActions: 'Next Actions',
      reviewNeeded: 'Review Needed',
      reviewDescription: 'Review now to optimize your memory retention',
      noReviewNeeded: 'All Clear!',
      noReviewDescription: 'Great job! You have completed all review tasks.',
      startReview: 'Start Review',
      viewCards: 'View Cards',
      newProblems: 'New Problem Set',
      newDescription: 'Curated for your skill level',
      personalizedRecommendation: 'Recommended',
      startLearning: 'Start Learning',
      quickAccess: 'Quick Access',
      quizSets: 'Quiz Sets',
      statistics: 'Statistics',
      create: 'Create',
      guide: 'Guide',
      rankName: 'Master Learner',
    },
  };

  const translations = t[language];

  if (isLoading) {
    return (
      <div className="max-w-6xl mx-auto space-y-6 px-4 py-6 animate-pulse">
        <Skeleton width="w-full" height="h-32" className="rounded-2xl" />
        <SkeletonStatGrid count={3} columns={3} />
        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          <Skeleton width="w-full" height="h-48" />
          <Skeleton width="w-full" height="h-48" />
        </div>
      </div>
    );
  }

  return (
    <div className="max-w-6xl mx-auto space-y-8 pb-24">
      {/* Header */}
      <DashboardHeader
        userName={userName}
        streakDays={streakDays}
        isDarkMode={!!isDarkMode}
        onToggleDarkMode={onToggleDarkMode}
      />

      {/* Hero Section with Ring Chart */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <GlassCard className="lg:col-span-2 flex flex-col md:flex-row items-center justify-between p-8 relative overflow-hidden">
          <div className="relative z-10 space-y-4 max-w-md">
            <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium">
              <Zap size={16} />
              <span>Level {level}</span>
            </div>
            <h2 className="text-3xl font-bold text-text-primary">
              {translations.greeting}
            </h2>
            <p className="text-text-secondary">
              {translations.subtitle}
            </p>

            <div className="flex gap-4 pt-4">
              <div className="flex flex-col">
                <span className="text-2xl font-bold text-text-primary">{todayQuestions}</span>
                <span className="text-xs text-text-muted uppercase tracking-wider">{translations.solvedProblems}</span>
              </div>
              <div className="w-px h-10 bg-glass-border" />
              <div className="flex flex-col">
                <span className="text-2xl font-bold text-text-primary">{todayAccuracy}%</span>
                <span className="text-xs text-text-muted uppercase tracking-wider">{translations.accuracy}</span>
              </div>
              <div className="w-px h-10 bg-glass-border" />
              <div className="flex flex-col">
                <span className="text-2xl font-bold text-text-primary">
                  {learningTime >= 1 ? `${learningTime}m` : `${learningTimeSeconds}s`}
                </span>
                <span className="text-xs text-text-muted uppercase tracking-wider">{translations.learningTime}</span>
              </div>
            </div>
          </div>

          <div className="mt-8 md:mt-0 relative">
            <RingChart
              current={todayQuestions}
              target={todayGoal}
              label={translations.todayProgress}
              subLabel={`${todayQuestions}/${todayGoal}`}
            />
          </div>

          {/* Background Decorative Elements */}
          <div className="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4" />
          <div className="absolute bottom-0 left-0 w-48 h-48 bg-accent/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4" />
        </GlassCard>

        {/* Streak Card */}
        <GlassCard className="flex flex-col items-center justify-center text-center space-y-4 relative overflow-hidden group">
          <div className="relative">
            <motion.div
              animate={{ scale: [1, 1.1, 1], opacity: [0.8, 1, 0.8] }}
              transition={{ duration: 2, repeat: Infinity, ease: "easeInOut" }}
              className="absolute inset-0 bg-orange-500/20 blur-xl rounded-full"
            />
            <Flame size={48} className={`text-orange-500 relative z-10 ${streakDays > 0 ? 'animate-pulse-slow' : 'opacity-50'}`} fill={streakDays > 0 ? "currentColor" : "none"} />
          </div>
          <div>
            <div className="text-4xl font-bold text-text-primary">{streakDays}</div>
            <div className="text-sm text-text-secondary uppercase tracking-wider">Day Streak</div>
          </div>
          <p className="text-xs text-text-muted max-w-[150px]">
            Keep learning every day to build your streak!
          </p>
        </GlassCard>
      </div>

      {/* Recommended Actions Grid */}
      <div>
        <h3 className="text-xl font-bold text-text-primary mb-4 flex items-center gap-2">
          <Target className="text-primary" size={20} />
          {translations.recommendedActions}
        </h3>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {/* Review Action */}
          <GlassCard variant={reviewNeeded > 0 ? 'warning' : 'success'} className="flex flex-col justify-between group hover:border-opacity-50 transition-all duration-300">
            <div className="flex justify-between items-start mb-4">
              <div className="p-3 rounded-xl bg-surfaceHighlight">
                <Clock className={`w-6 h-6 ${reviewNeeded > 0 ? 'text-orange-500' : 'text-green-500'}`} />
              </div>
              {reviewNeeded > 0 && (
                <span className="px-2 py-1 rounded-lg bg-orange-500/20 text-orange-400 text-xs font-bold">
                  Priority
                </span>
              )}
            </div>

            <div className="mb-6">
              <h4 className="text-lg font-bold text-text-primary mb-1">
                {reviewNeeded > 0 ? translations.reviewNeeded : translations.noReviewNeeded}
              </h4>
              <p className="text-sm text-text-secondary">
                {reviewNeeded > 0 ? `${reviewNeeded} items due - ${translations.reviewDescription}` : translations.noReviewDescription}
              </p>
            </div>

            <NeumorphicButton
              variant={reviewNeeded > 0 ? 'primary' : 'secondary'}
              onClick={() => onNavigate('spacedRepetition')}
              fullWidth
              className="mt-auto"
            >
              {reviewNeeded > 0 ? translations.startReview : translations.viewCards}
            </NeumorphicButton>
          </GlassCard>

          {/* Recommendation Action */}
          <GlassCard variant="primary" className="flex flex-col justify-between group hover:border-opacity-50 transition-all duration-300">
            <div className="flex justify-between items-start mb-4">
              <div className="p-3 rounded-xl bg-surfaceHighlight">
                <Sparkles className="w-6 h-6 text-blue-500" />
              </div>
              <span className="px-2 py-1 rounded-lg bg-blue-500/20 text-blue-400 text-xs font-bold">
                Recommended
              </span>
            </div>

            <div className="mb-6">
              <h4 className="text-lg font-bold text-text-primary mb-1">
                {translations.personalizedRecommendation}
              </h4>
              <p className="text-sm text-text-secondary">
                {recommendedQuizSet
                  ? `${recommendedQuizSet.name}`
                  : translations.newDescription}
              </p>
            </div>

            <NeumorphicButton
              variant="primary"
              onClick={() => recommendedQuizSet ? onNavigate('quizSets') : onNavigate('quiz')}
              fullWidth
              className="mt-auto"
            >
              {translations.startLearning}
            </NeumorphicButton>
          </GlassCard>
        </div>
      </div>

      {/* Quick Access Grid */}
      <div>
        <h3 className="text-xl font-bold text-text-primary mb-4 flex items-center gap-2">
          <Zap className="text-yellow-500" size={20} />
          {translations.quickAccess}
        </h3>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[
            { id: 'quizSets', icon: BookOpen, label: translations.quizSets, color: 'text-blue-500' },
            { id: 'stats', icon: BarChart3, label: translations.statistics, color: 'text-purple-500' },
            { id: 'editor', icon: Plus, label: translations.create, color: 'text-green-500' },
            { id: 'guide', icon: HelpCircle, label: translations.guide, color: 'text-orange-500' },
          ].map((item) => (
            <NeumorphicButton
              key={item.id}
              variant="secondary"
              onClick={() => onNavigate(item.id as any)}
              className="flex-col h-32 gap-3 group hover:-translate-y-1 transition-transform duration-300"
            >
              <div className="p-3 rounded-full bg-surfaceHighlight group-hover:bg-background transition-colors duration-300">
                <item.icon className={`w-6 h-6 ${item.color}`} />
              </div>
              <span className="text-sm font-medium text-text-primary">{item.label}</span>
            </NeumorphicButton>
          ))}
        </div>
      </div>

      <UserNameSettings
        isOpen={showNameSettings}
        onClose={() => setShowNameSettings(false)}
        currentName={userName}
        onSave={handleSaveUserName}
        language={language}
      />
    </div>
  );
}
