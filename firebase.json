{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "root",
      "ignore": [
        "node_modules",
        ".git",
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/create-checkout-session",
        "function": "createCheckoutSession"
      },
      {
        "source": "/create-portal-session",
        "function": "createPortalSession"
      },
      {
        "source": "/stripe-webhook",
        "function": "stripeWebhook"
      },
      {
        "source": "/**",
        "destination": "/index.html"
      }
    ]
  }
}
