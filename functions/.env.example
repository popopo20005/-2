# ============================================================
# Firebase Cloud Functions - 環境変数テンプレート
# このファイルを .env にコピーして値を設定してください
# ============================================================

# Stripe シークレットキー (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# Stripe Webhook署名シークレット (whsec_...)
# Stripe Dashboard → Developers → Webhooks で取得
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe Price IDs (Dashboard → Products で確認)
STRIPE_BASIC_PRICE=price_YOUR_BASIC_PRICE_ID
STRIPE_PREMIUM_PRICE=price_YOUR_PREMIUM_PRICE_ID

# アプリのURL (レスポンス後リダイレクト先)
APP_URL=https://YOUR_APP_URL
